# Normalize line endings across Windows / macOS / Linux.
# Default: text files use LF in the repo and on checkout.
* text=auto eol=lf

# POSIX shell + Python must be LF (a CRLF shebang breaks on macOS/Linux).
*.sh      text eol=lf
*.py      text eol=lf
*.command text eol=lf
dulusbar  text eol=lf

# Windows-only scripts stay CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets — never touch.
*.png   binary
*.ico   binary
*.icns  binary
